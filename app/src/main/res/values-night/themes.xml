<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Application_stock" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Principales -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorOnPrimary">@color/black</item> <!-- Texto negro sobre fondo azul claro -->
        <item name="colorPrimaryContainer">@color/purple_700</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Fondo y Superficies -->
        <item name="android:colorBackground">@color/background_color</item>
        <item name="colorSurface">@color/surface_color</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Colores de Texto -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Control de Estados (RadioButtons, CheckBoxes, etc) -->
        <item name="colorControlActivated">@color/purple_500</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>